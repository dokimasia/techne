go 1.27.0

// The repository root module (go.dokimi.dev/techne) holds the binary and
// the composition root. Every other module is listed here so local
// development resolves across them without replace directives.
use (
	./
	./techne-core
	./techne-lang
	./techne-lang-c
	./techne-lang-csharp
	./techne-lang-go
	./techne-lang-java
	./techne-lang-javascript
	./techne-lang-python
	./techne-lang-ruby
	./techne-lang-rust
	./techne-lang-scala
	./techne-lang-typescript
	./techne-presenter
)
